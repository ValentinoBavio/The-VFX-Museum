{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "5497a80bb78d43db85437b146363a554",
    "m_Title": "Frag4, funcion creada aparte",
    "m_Content": "N() / N13() → Generan valores aleatorios para la posición, tamaño y movimiento de las gotas.\nStaticDrops() → Crea pequeñas gotas estáticas sobre el vidrio.\nDropLayer2() → Genera gotas en movimiento con sus estelas (trails).\nDrops() → Combina las capas de gotas estáticas y en movimiento en una sola máscara de lluvia.\nfrag4_float() →\nLlama a Drops() para generar el patrón de lluvia.\nCalcula el vector de distorsión UV (_Out) a partir de píxeles vecinos.\nCalcula el nivel de desenfoque (_Lod) según la intensidad de las gotas y sus estelas.\nEstos valores se usan con Sample Buffer para distorsionar y desenfocar la escena, simulando el efecto de un vidrio mojado.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -885.0,
        "y": 167.0,
        "width": 200.0,
        "height": 388.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

